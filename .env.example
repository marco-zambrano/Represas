NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Clave privada para la API de Responses. Nunca usar el prefijo NEXT_PUBLIC_.
OPENAI_API_KEY=sk_replace_me
# Endpoint CELEC identificado y autorizado para la telemetría pública.
# CELEC uses its documented ORDS URL by default. Only set this for a test
# environment or an authorized proxy.
# CELEC_ORDS_BASE_URL=https://generacioncsr.celec.gob.ec:8443/ords/csr

# Opcional: endpoint de forecast GEOGLOWS y tramo por cada central. El endpoint
# recibe los parámetros reach_id, start y end; usa un proxy autorizado si aplica.
# GEOGLOWS_FORECAST_URL=https://your-geoglows-endpoint.example/forecast
# GEOGLOWS_REACH_ID_MAZAR=replace_me
# GEOGLOWS_REACH_ID_PAUTE_MOLINO=replace_me
# GEOGLOWS_REACH_ID_SOPLADORA=replace_me
# GEOGLOWS_REACH_ID_MINAS_SAN_FRANCISCO=replace_me
# GEOGLOWS_REACH_ID_COCA_CODO_SINCLAIR=replace_me

# Opcional: las cinco series INAMHI para la estimación CCS a 3 horas.
# INAMHI_CCS_H0719_URL=https://your-inamhi-endpoint.example/h0719
# INAMHI_CCS_H0728_URL=https://your-inamhi-endpoint.example/h0728
# INAMHI_CCS_M1124_URL=https://your-inamhi-endpoint.example/m1124
# INAMHI_CCS_M5247_URL=https://your-inamhi-endpoint.example/m5247
# INAMHI_CCS_M5124_URL=https://your-inamhi-endpoint.example/m5124
